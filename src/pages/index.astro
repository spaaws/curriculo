---
import Layout from '../layouts/Layout.astro';
import CardProjeto from '../components/CardProjeto.astro';
---

<Layout title="Wellington | Portfólio Profissional">
	<main class="container">
		<header class="hero">
			<h1>Olá, eu sou o Wellington</h1>
			<p>Desenvolvendo soluções eficientes e construindo produtos digitais com propósito.</p>
		</header>

		<section id="projetos">
			<h2>Meus Projetos</h2>
			<div class="grid">
				<CardProjeto 
					title="INSS Check" 
					description="Plataforma dedicada à análise detalhada e facilitação na simulação de benefícios previdenciários."
					tags={['Produto Digital', 'Análise', 'Web']}
				/>
				<CardProjeto 
					title="PSICOFLY" 
					description="Estruturação de produto e desenvolvimento de planos de assinatura voltados para serviços de psicologia."
					tags={['SaaS', 'Assinaturas', 'Saúde Mental']}
				/>
			</div>
		</section>
	</main>
</Layout>

<style>
	.container {
		max-width: 1000px;
		margin: 0 auto;
		padding: 2rem;
	}
	.hero {
		text-align: center;
		padding: 4rem 0;
	}
	h1 {
		font-size: 3rem;
		font-weight: 800;
		margin: 0;
	}
	.text-gradient {
		background-image: linear-gradient(45deg, var(--accent-color), #8b5cf6);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-size: 400%;
		background-position: 0%;
	}
	.hero p {
		font-size: 1.25rem;
		color: #475569;
		margin-top: 1rem;
	}
	section {
		margin-top: 4rem;
	}
	h2 {
		font-size: 2rem;
		margin-bottom: 2rem;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}
</style>